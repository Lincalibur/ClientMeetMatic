# Copy this file to .env and fill in your own values. Never commit your real .env file.

# Google Maps API key with the Distance Matrix API enabled.
# Get one at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: path to the client list Excel file. Defaults to "Client List/Clients.xlsx".
# Point this at "Client List/Clients.sample.xlsx" to try the app with sample data.
CLIENT_LIST_FILE=Client List/Clients.xlsx
